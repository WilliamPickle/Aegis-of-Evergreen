[node name="text8" type="Label" parent="ScreenContainer/Contents/Pages/Page9and10"]
layout_mode = 0
offset_left = 312.0
offset_top = 168.0
offset_right = 501.0
offset_bottom = 196.0
scale = Vector2(1.2, 1.2)
text = "Asian Hornets is equally as aggressive as her kin. Furthermore, after wearing her down, she'll get even more aggressive."
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

[node name="text9" type="Label" parent="ScreenContainer/Contents/Pages/Page9and10"]
layout_mode = 0
offset_left = 332.0
offset_top = 220.0
offset_right = 491.0
offset_bottom = 278.0
scale = Vector2(1.2, 1.2)
text = "Though not typically aggressive towards us humans, Asian hornets are ruthless hunters of other bugs. As invaders, they can disrupt many kinds of native insects/spiders."
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

[node name="Page11and12" type="TextureRect" parent="ScreenContainer/Contents/Pages"]
