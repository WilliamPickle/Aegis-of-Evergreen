offset_right = 493.0
offset_bottom = 177.0
scale = Vector2(1.2, 1.2)
text = "not be the most intimidating foe, but beware of the chemicals it releases. Our allies might experience slowness after inhaling it. "
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

[node name="text7" type="Label" parent="ScreenContainer/Contents/Pages/Page7and8"]
