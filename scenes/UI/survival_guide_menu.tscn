offset_right = 86.0
offset_bottom = 152.0
scale = Vector2(1.2, 1.2)
text = "ranges. The acid they spit"
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

[node name="text3" type="Label" parent="ScreenContainer/Contents/Pages/Page5and6"]
layout_mode = 0
offset_left = 18.0
offset_top = 158.0
offset_right = 201.0
offset_bottom = 188.0
scale = Vector2(1.2, 1.2)
text = "out also seem to induce special side-effects on most foes. Rumour has it that our flytraps have undergone mutations..."
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

[node name="text5" type="Label" parent="ScreenContainer/Contents/Pages/Page5and6"]
layout_mode = 0
offset_left = 44.0
offset_top = 220.0
offset_right = 201.0
offset_bottom = 270.0
scale = Vector2(1.2, 1.2)
text = "In reality, Venus Flytraps attack bugs by trapping them in their \"mouths\" and digesting them. Our flytraps however have miraculously evolved to spit acid instead."
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

[node name="heading4" type="Label" parent="ScreenContainer/Contents/Pages/Page5and6"]
layout_mode = 0
offset_left = 346.0
offset_top = 150.0
offset_right = 568.0
offset_bottom = 174.0
scale = Vector2(0.75, 0.75)
text = "- Coming Soon -"
label_settings = ExtResource("12_m5axs")

[node name="text6" type="Label" parent="ScreenContainer/Contents/Pages/Page5and6"]
layout_mode = 0
offset_left = 326.0
offset_top = 174.0
offset_right = 483.0
offset_bottom = 224.0
scale = Vector2(1.2, 1.2)
text = "As time passes, the forest requires more allies to fend off the growing threats. Rest assured, more allies are getting ready to join the fight. "
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

