offset_bottom = 134.0
scale = Vector2(1.2, 1.2)
text = "This is just a cow. It might"
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

[node name="text8" type="Label" parent="ScreenContainer/Contents/Pages/Page7and8"]
