[node name="text1" type="Label" parent="ScreenContainer/BackCoverMargin"]
layout_mode = 0
offset_left = 140.0
offset_top = 64.0
offset_right = 256.0
offset_bottom = 115.0
scale = Vector2(1.2, 1.2)
text = "Volunteer, this is the end of the survival guide. It was an honor to guide you through it. As for my final note to you:"
label_settings = SubResource("LabelSettings_jn14j")
autowrap_mode = 2

[node name="heading" type="Label" parent="ScreenContainer/BackCoverMargin"]
layout_mode = 0
offset_left = 88.0
offset_top = 27.0
offset_right = 178.0
offset_bottom = 51.0
text = "The End"
label_settings = SubResource("LabelSettings_fwyu7")

[node name="heading3" type="Label" parent="ScreenContainer/BackCoverMargin"]
layout_mode = 0
offset_left = 54.0
offset_top = 142.0
offset_right = 243.0
offset_bottom = 166.0
scale = Vector2(0.75, 0.75)
text = "- Thank You. -"
label_settings = SubResource("LabelSettings_ewo21")

[node name="text2" type="Label" parent="ScreenContainer/BackCoverMargin"]
layout_mode = 0
offset_left = 54.0
offset_top = 162.0
offset_right = 170.0
offset_bottom = 213.0
scale = Vector2(1.2, 1.2)
text = "The forest lives because of volunteers like you. While dangers and foe continue to emerge, your efforts have the ability  to fend them off. "
label_settings = SubResource("LabelSettings_jn14j")
autowrap_mode = 2

