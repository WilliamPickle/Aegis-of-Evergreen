[node name="Title" type="Label" parent="ScreenContainer/Contents/Pages/Page1and2"]
layout_mode = 0
offset_left = 37.0
offset_top = 33.0
offset_right = 241.0
offset_bottom = 81.0
scale = Vector2(0.9, 0.9)
theme_override_fonts/font = ExtResource("6_dq160")
theme_override_font_sizes/font_size = 48
text = "Welcome"

[node name="text1" type="Label" parent="ScreenContainer/Contents/Pages/Page1and2"]
layout_mode = 0
offset_left = 103.0
offset_top = 110.0
offset_right = 197.0
offset_bottom = 161.0
scale = Vector2(1.2, 1.2)
text = "Greetings, new volunteer. I am the ranger of this forest, here to help you with this guide. "
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

[node name="text2" type="Label" parent="ScreenContainer/Contents/Pages/Page1and2"]
layout_mode = 0
offset_left = 28.0
offset_top = 180.0
offset_right = 198.0
offset_bottom = 238.0
scale = Vector2(1.2, 1.2)
text = "It is your job to help kick out the unwanted visitors of the forest. Here, you will equip yourself with the knowledge required to effectively defend it. 
"
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

[node name="text3" type="Label" parent="ScreenContainer/Contents/Pages/Page1and2"]
layout_mode = 0
offset_left = 437.0
offset_top = 86.0
offset_right = 524.0
offset_bottom = 194.0
scale = Vector2(1.2, 1.2)
text = "First, let me introduce myself. I am a \"hero\" type tower, meaning only one of me exists at a time. I encourage our allies and give them various buffs. 
"
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

[node name="text4" type="Label" parent="ScreenContainer/Contents/Pages/Page1and2"]
layout_mode = 0
offset_left = 338.0
offset_top = 220.0
offset_right = 494.0
offset_bottom = 278.0
scale = Vector2(1.2, 1.2)
text = "On that fateful day, on the arrival of the UFO, it was the ranger who rallied the allies of the forest to fight. \"Would we fail to defend? Nah, we'd win.\"
"
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

[node name="heading" type="Label" parent="ScreenContainer/Contents/Pages/Page1and2"]
layout_mode = 0
offset_left = 329.0
offset_top = 27.0
offset_right = 419.0
offset_bottom = 51.0
text = "Ranger"
label_settings = ExtResource("11_exfpv")

[node name="heading2" type="Label" parent="ScreenContainer/Contents/Pages/Page1and2"]
layout_mode = 0
