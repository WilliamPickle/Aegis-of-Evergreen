label_settings = ExtResource("11_exfpv")

[node name="heading5" type="Label" parent="ScreenContainer/Contents/Pages/Page3and4"]
layout_mode = 0
offset_left = 63.0
offset_top = 202.0
offset_right = 252.0
offset_bottom = 226.0
scale = Vector2(0.75, 0.75)
text = "- Extra Facts -"
label_settings = ExtResource("12_m5axs")

[node name="text2" type="Label" parent="ScreenContainer/Contents/Pages/Page3and4"]
layout_mode = 0
offset_left = 44.0
offset_top = 220.0
offset_right = 195.0
offset_bottom = 278.0
scale = Vector2(1.2, 1.2)
text = "During cold times, chipmunks will hibernate in their own dens. They also store the acorns they'd scavenged for here.  Most of their winters are spent sleeping."
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

[node name="text3" type="Label" parent="ScreenContainer/Contents/Pages/Page3and4"]
layout_mode = 0
offset_left = 310.0
offset_top = 132.0
offset_right = 365.0
offset_bottom = 149.0
scale = Vector2(1.2, 1.2)
text = "The bees are masters"
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

[node name="text4" type="Label" parent="ScreenContainer/Contents/Pages/Page3and4"]
layout_mode = 0
offset_left = 310.0
offset_top = 156.0
offset_right = 439.0
offset_bottom = 189.0
scale = Vector2(1.2, 1.2)
text = "of the air. They utilize advanced avionics to drop hives full of honey on foes."
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

[node name="text5" type="Label" parent="ScreenContainer/Contents/Pages/Page3and4"]
layout_mode = 0
offset_left = 335.0
offset_top = 220.0
offset_right = 493.0
offset_bottom = 278.0
scale = Vector2(1.2, 1.2)
text = "Bees are without a doubt the backbone of our ecosystems. One  reason for this is their  pollination abilities. Their overall populations, however, are on a decline. "
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

