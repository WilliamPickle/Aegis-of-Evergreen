[node name="text2" type="Label" parent="ScreenContainer/Contents/Pages/Page11and12"]
layout_mode = 0
offset_left = 41.0
offset_top = 206.0
offset_right = 198.0
offset_bottom = 266.0
scale = Vector2(1.2, 1.2)
text = "As time passes, the scent of smoke grows. The skies darken, the rivers lose color, and the trees are decaying . . . However, I fear that this isn't the result of an alien force. It resides in the forest. "
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

