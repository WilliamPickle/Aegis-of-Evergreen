offset_top = 80.0
offset_right = 119.0
offset_bottom = 160.0
scale = Vector2(1.2, 1.2)
text = "This is the vessel of our invaders. Coming from an unknown world, it spews out countless foe. However, it appears that it is not the only harm to our forest. "
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

[node name="heading" type="Label" parent="ScreenContainer/Contents/Pages/Page11and12"]
