[node name="text1" type="Label" parent="ScreenContainer/Contents/Pages/Page3and4"]
layout_mode = 0
offset_left = 25.0
offset_top = 134.0
offset_right = 206.0
offset_bottom = 192.0
scale = Vector2(1.2, 1.2)
text = "This is your first ally, the reliable Chipmunk. He's cheap to place and will be great at picking off weaker foe. I've also heard he'd started a workout regimen of some sort too...
"
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

