offset_top = 208.0
offset_right = 488.0
offset_bottom = 268.0
scale = Vector2(1.2, 1.2)
text = "While not invasive like prior foe, many natural habitats have been removed to make room for them. Cows emite a lot of methane too, which is a more potent greenhouse gas than carbon dioxide."
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

