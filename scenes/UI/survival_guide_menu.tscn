offset_right = 198.0
offset_bottom = 270.0
scale = Vector2(1.2, 1.2)
text = "To some part of the world, these are invasive species. They disrupt ecosystems that they don't belong in by hoarding resources and harming the native species. "
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

[node name="heading6" type="Label" parent="ScreenContainer/Contents/Pages/Page7and8"]
