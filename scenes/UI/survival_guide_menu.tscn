offset_right = 57.0
offset_bottom = 122.0
scale = Vector2(1.2, 1.2)
text = "Venus Flytraps are excellent at close"
label_settings = ExtResource("10_nd06i")
autowrap_mode = 2

[node name="text2" type="Label" parent="ScreenContainer/Contents/Pages/Page5and6"]
layout_mode = 0
offset_left = 18.0
